# SPDX-License-Identifier: AGPL-3.0-or-later

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,m,mm,metal}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
